# LeanMe site — environment variables (copy to .env.local)

NEXT_PUBLIC_SITE_URL=https://demo.leanme.it

# Teresa pubblica (chat nativa Lean.Agent — solo sito pubblico)
OPENAI_API_KEY=
OPENAI_TERESA_MODEL=gpt-4.1-mini

# Notifiche email SOLO per Teresa pubblica (Brevo, non lean-event / tenant)
BREVO_API_KEY=
TERESA_NOTIFY_TO=info@leanme.it
TERESA_NOTIFY_FROM=LeanMe Teresa <info@leanme.it>

# Supervisione /lean-human (operatori LeanMe)
LEAN_HUMAN_PASSWORD=
LEAN_HUMAN_SESSION_SECRET=

# Persistenza chat Teresa in produzione (Vercel Blob).
# Senza token/store, su Vercel i thread restano in /tmp e spariscono tra le funzioni.
BLOB_READ_WRITE_TOKEN=
